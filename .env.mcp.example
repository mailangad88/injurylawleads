# Credentials for the MCP servers in .mcp.json. See docs/mcp-servers.md.
# Copy to .env.mcp (gitignored), fill in, then start Claude Code with:
#   set -a; source .env.mcp; set +a; claude
# Never commit real values: this repo is public.

# Google Search Console: absolute path to an OAuth "Desktop app" client JSON
GSC_OAUTH_CLIENT_SECRETS_FILE=/absolute/path/to/gsc_client_secrets.json

# Google Cloud project used by Google Analytics 4 and Google Ads
# (auth comes from `gcloud auth application-default login`, see the docs)
GOOGLE_CLOUD_PROJECT=
# Only if you reach the Ads account through a manager (MCC) account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Microsoft Clarity: Settings > Data Export > Generate new API token
CLARITY_API_TOKEN=

# Twilio: a Standard API key (not the auth token). Account SID is shared with the app.
TWILIO_ACCOUNT_SID=
TWILIO_MCP_API_KEY=
TWILIO_MCP_API_SECRET=

# Reddit: a "script" app from https://www.reddit.com/prefs/apps (read-only use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Firecrawl: https://firecrawl.dev (free tier, then paid credits)
FIRECRAWL_API_KEY=

# Meta Ads (Pipeboard) and Resend sign in with OAuth from /mcp, so they need no keys here.
