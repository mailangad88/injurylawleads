# Copy to .env.local and fill in. Never commit real values: this repo is public.

# --- Public site settings ---
NEXT_PUBLIC_SITE_NAME="Injury Claim Guide"
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Only set this once the number is answered by real people.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CALLBACK_PROMISE="within minutes during business hours"
NEXT_PUBLIC_LEGAL_ENTITY="Your Company LLC"
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Where leads are stored ---
# webhook (production) or file (local dev only, writes data/leads.ndjson)
LEAD_STORE=webhook
# Zapier / Make / n8n catch hook, your CRM, or your own API endpoint
LEAD_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>"
LEAD_WEBHOOK_SECRET=

# --- Instant alerts (set at least one) ---
# Email via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_ALERT_EMAIL_FROM="Leads <leads@yourdomain.com>"
LEAD_ALERT_EMAIL_TO=intake@yourdomain.com

# SMS via Twilio to your intake team's phones (comma separated, E.164 format)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100
LEAD_ALERT_SMS_TO=+15555550101

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# --- Remotion ---
REMOTION_BRAND="Injury Claim Guide"
